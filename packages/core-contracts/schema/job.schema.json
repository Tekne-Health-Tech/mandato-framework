{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mandato:schema:job-request:1",
  "title": "JobRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["queue", "payload", "data_class"],
  "properties": {
    "queue": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,15}\\.[a-z][a-z0-9_]{0,40}$" },
    "data_class": { "enum": ["C0", "C1", "C2", "C3"] },
    "idempotency_key": { "type": "string", "maxLength": 200 },
    "payload": { "$ref": "#/$defs/refsOnly" }
  },
  "$defs": {
    "refsOnly": {
      "type": "object",
      "propertyNames": { "not": { "pattern": "^(pii|phi|piim|enc)_" } },
      "additionalProperties": {
        "anyOf": [
          { "type": ["string", "number", "boolean", "null"], "maxLength": 200 },
          { "type": "array", "items": { "type": ["string", "number"], "maxLength": 200 } },
          { "$ref": "#/$defs/refsOnly" }
        ]
      }
    }
  }
}
