{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mandato:schema:module:1",
  "title": "mandato.module.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "short", "version", "requires_framework", "requires_modules", "data_classes", "roles", "permissions", "retention", "data_subject"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}\\.[a-z][a-z0-9_]{0,30}$" },
    "short": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,15}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "requires_framework": { "type": "string", "minLength": 1 },
    "requires_modules": { "type": "array", "items": { "type": "string" } },
    "data_classes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["C0", "C1", "C2", "C3"] } },
    "roles": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": { "id": { "type": "string" }, "label": { "type": "string" } } }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "roles"],
        "properties": { "id": { "type": "string" }, "roles": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "migrations": { "type": "string" },
    "web": { "type": "string" },
    "mobile": { "type": "string" },
    "worker": { "type": "string" },
    "settings_schema": { "type": "string" },
    "retention": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["table", "days"], "properties": { "table": { "type": "string" }, "days": { "type": "integer", "minimum": 1 } } }
    },
    "data_subject": { "type": ["string", "null"] }
  },
  "allOf": [
    { "if": { "properties": { "data_classes": { "contains": { "enum": ["C2", "C3"] } } } },
      "then": { "properties": { "data_subject": { "type": "string" } } } }
  ]
}
