{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mandato:schema:tenant:1",
  "title": "tenant.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instance", "parliamentarian", "locale", "timezone", "causes", "theme", "labels", "legal", "channels", "connectors", "modules", "publish_keys", "ai"],
  "properties": {
    "schema_version": { "const": 1 },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "display_name", "house", "office"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,30}$" },
        "display_name": { "type": "string", "minLength": 1 },
        "house": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "acronym", "uf"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "acronym": { "type": "string", "minLength": 1 },
            "uf": { "type": "string", "pattern": "^[A-Z]{2}$" }
          }
        },
        "office": { "enum": ["deputado_estadual", "deputado_federal", "senador", "vereador"] }
      }
    },
    "parliamentarian": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_name", "pronoun_style"],
      "properties": {
        "public_name": { "type": "string", "minLength": 1 },
        "pronoun_style": { "enum": ["neutral", "feminine", "masculine"] }
      }
    },
    "locale": { "const": "pt-BR" },
    "timezone": { "type": "string", "pattern": "^[A-Za-z]+/[A-Za-z_]+$" },
    "causes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "name", "icon"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$" },
          "name": { "type": "string", "minLength": 1 },
          "icon": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    },
    "theme": { "type": "string", "pattern": "^[a-zA-Z0-9_./-]+\\.json$" },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_assisted"],
      "properties": { "ai_assisted": { "type": "string", "minLength": 10 } }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacy_policy_url", "data_controller", "dpo"],
      "properties": {
        "privacy_policy_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "data_controller": { "type": "string", "minLength": 1 },
        "dpo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "email"],
          "properties": { "name": { "type": "string" }, "email": { "type": "string", "format": "email" } }
        }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email"],
      "properties": {
        "email": { "type": "string", "format": "email" },
        "telegram_channel": { "type": ["string", "null"] },
        "whatsapp_channel_url": { "type": ["string", "null"], "pattern": "^https://(www\\.)?whatsapp\\.com/channel/" }
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "schedule"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,60}$" },
          "schedule": { "type": "string", "pattern": "^(\\S+\\s+){4}\\S+$" },
          "params": { "$ref": "#/$defs/noSecrets" }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/$defs/moduleId" },
          "settings": { "type": "object" }
        }
      }
    },
    "publish_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "role", "public_key"],
        "properties": {
          "key_id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["current", "next"] },
          "public_key": { "type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]{43}$" }
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providers"],
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "locality", "max_data_class", "egress"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,40}$" },
              "locality": { "enum": ["local", "external"] },
              "max_data_class": { "enum": ["C0", "C1", "C2", "C3"] },
              "egress": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9.-]+(:[0-9]+)?$" } }
            },
            "allOf": [
              { "if": { "properties": { "locality": { "const": "external" } } }, "then": { "properties": { "max_data_class": { "not": { "const": "C3" } } } } }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "moduleId": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}\\.[a-z][a-z0-9_]{0,30}$" },
    "noSecrets": {
      "type": "object",
      "propertyNames": { "not": { "pattern": "([Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Aa][Pp][Ii]_?[Kk][Ee][Yy])$" } },
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    }
  }
}
